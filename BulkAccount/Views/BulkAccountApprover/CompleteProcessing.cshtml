                        <th scope="col">CIF</th>
                        <th scope="col">Failure Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AccountUpload.Any())
                    {
                        int count = 1;
                        @foreach (var item in Model.AccountUpload)
                        {
                            <tr>
                                <th scope="row">@count</th>

                                <td>@item.AccountName</td>
                                <td>@item.Status</td>
                                <td>@item.AccountNo</td>
