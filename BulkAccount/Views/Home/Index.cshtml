@{
    ViewData["Title"] = "Bulk Account Solution";
}

<!-- Start content -->
<div class="content">
    <div class="">
        <div class="page-header-title">
            <h4 class="page-title">@ViewBag.Title</h4>
        </div>
    </div>

    <div class="dashboard-row">
        <div class="dashboard-card">
            <a>
                TOTAL COMPLETED ACCOUNTS
            </a>
            <p>
                <a> <h3>@ViewBag.TotalAccts</h3> </a>
            </p>
        </div>
        <div class="dashboard-card">
            <a>
                TOTAL COMPLETED ACCOUNTS FROM DATE RANGE
            </a>
            <p>
                <a> <h3>@ViewBag.TotalAcctsFromDate</h3> </a>
            </p>
        </div>
    </div>

    <div class="page-content-wrapper" style="margin-top:22px">
        <form asp-controller="Home" asp-action="Index" method="get" class="row d-flex justify-content-center text-center" style="color:#337ab7">
            <p><strong>SELECT DATE RANGE</strong></p>

            <label for="fromDate">From:</label>
            <input type="date" id="fromDate" name="fromDate" required />

            <label for="toDate">To:</label>
            <input type="date" id="toDate" name="toDate" style="width: 160px;" required />

            <button type="submit" class="btn btn-primary btn-sm" style="margin-left: 10px;">Filter</button>
        </form>
    </div>

    <div class="page-content-wrapper" style="margin-top:22px">
        <!-- Start container -->
        <div class="row d-flex justify-content-center">

            <p style="margin-top: 24px" class="text-danger text-center"> <strong> Please download the template below for your bulk accounts opening request.</strong></p>
            <p class="text-danger text-center">Do not change the headings on the template. Only fill the fields accordingly.</p>
            
            <div class="text-center" style="">
                <br />
                <a href="DownloadTemplate" class="btn btn-primary">Download File Template</a>
            </div>

        </div>

        <!-- End container -->
    </div>
    <!-- Page content Wrapper -->

</div>
<!-- content -->